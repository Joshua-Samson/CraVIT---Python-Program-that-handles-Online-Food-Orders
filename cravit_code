#Registering user function
def register():
    print("----- Register New User -----")

    while True:
        username = input("Enter a new username: ")
        mydb.execute("select * from customers where customer_name=%s", (username,))
        if mydb.fetchone():
            print("Username already exists. Try a different one.")
        else:
            break
    password = input("Enter a new password: ")
    mydb.execute("insert into customers (customer_name, password) VALUES (%s, %s)", (username, password))
    db.commit()
    print(f"Registration successful! You can now log in as {username}.\n")

#User login function
def login():
    print("\nWelcome to CraVIT!")
    print("Please log in to continue\n")
    while True:
        username = input("Enter Username: ")
        password = input("Enter Password: ")
        mydb.execute("select * from customers where customer_name=%s AND password=%s", (username, password))
        user = mydb.fetchone()
        if user:
            print(f"\nLogin Successful!\n Welcome, {username}.\n")
            while True:
                print(f"\n=======HOME PAGE ({username}) =======")
                print("Select where would you like to eat:")
                restaurant(restaurant1)
                try:
                    choice_rest=int(input("Enter choice:"))
                    if abs(choice_rest)<=len(restaurant1):
                        menu1={}
                        while True:
                            print(f"\n======={(restaurant1[choice_rest].replace("_"," ")).title()} PAGE=======")
                            print("1. View Menu")
                            print("2. Add to Cart")
                            print("3. Remove Item from Cart")
                            print("4. Show Cart")
                            print("5. View Past Orders")
                            print("6. Checkout")
                            choice=input("Enter your choice: ")
                            option=restaurant1[choice_rest]
                            if choice == '1':
                                menu(menu1,option)
                            elif choice=='2':
                                menu(menu1,option)
                                cart(menu1,option)
                            elif choice == '3':
                                remove_from_cart()
                            elif choice == '4':
                                show_cart()
                            elif choice == '5':
                                past_orders(username)
                            elif choice == '6':
                                if customer_order:
                                    ord_no=save_order_to_db(username,option)
                                    if ord_no!=False:
                                        show_cart()
                                        delivery_time()
                                        print("\nThank you for ordering!")
                                        exit()
                            else:
                                print("Invalid choice, try again.")
                    else:
                        print("Choice not present in restaurant page.")
                except ValueError:
                    print("Invalid choice...Please try again")

        else:
            print("Invalid Username or Password, please try again.")
            retry = input("Enter 'R' to retry or 'Q' to quit: ").upper()
            if retry == 'Q':
                print("Exiting program. Goodbye!")
                exit()


#Displaying Cuisines
def restaurant(restaurant1):
    print("\n\n-----RESTAURANTS-----")
    for i in restaurant1:
        print(i,((restaurant1[i]).replace("_"," ").title()))
def menu(menu1,option):
    mydb.execute(f"select * from {option}")
    data=mydb.fetchall()
    headers = ["ItemNo.", "Name", "Veg/NonVeg","Type","Price"]
    if not menu1:
        for i in data:
            menu1[i[0]]=i[1:]
    print(tabulate(data, headers=headers, tablefmt="grid"))

#Adding items to cart
def cart(menu1, option):
    if not menu1:
        print("\nPlease view the menu (Option 1) before adding items to your cart!")
        return

    while True:
        try:
            choice = int(input("\nEnter the Item No to add to cart: "))
        except ValueError:
            print("Invalid input. Please enter a valid number.")
            continue
        
        if choice not in menu1:
            print("Invalid choice number. Try again.")
            continue
        
        item_details = menu1[choice]
        selected_item = (choice, item_details[0], item_details[1], item_details[2], item_details[3])
        
        customer_order.append(selected_item)
        print(f"Added '{selected_item[1]}' to your cart successfully!")
        
        cont = input("\nEnter 'Y' to add more items or any other key to return: ").strip().lower()
        if cont != 'y':
            break

#Showing items in cart
def show_cart():
    if not customer_order:
        print("\nYour cart is empty.")
        return

    cart_display = []
    for index, item in enumerate(customer_order, start=1):
        cart_display.append((index, item[1], item[2], item[3], item[4]))

    header = ["S No", "Item", "Veg/NonVeg","Type","Price"]
    print("\n----- Your Cart -----")
    print(tabulate(cart_display, headers=header, tablefmt='grid', numalign="right", stralign="left"))
    total = sum(item[4] for item in customer_order)
    print(f"\nTotal Price: ₹{total}")

#Removing items from cart
def remove_from_cart():
    if not customer_order:
        print("\nYour cart is empty. Nothing to remove.")
        return
    show_cart()
    try:
        item_no = int(input("\nEnter the item number to remove: "))
        if 1 <= item_no <= len(customer_order):
            removed_item = customer_order.pop(item_no - 1)
            print(f"Removed {removed_item[1]} from your cart.")
        else:
            print(f"S No. {item_no} is not valid.")
    except ValueError:
        print("Invalid input. Please enter a number.")

#Delivery time
def delivery_time():
    delivery_time = random.randint(25, 90)
    print(f"\n\tEstimated Delivery Time: {delivery_time} minutes")

#View past orders
def save_order_to_db(username, restaurant_name):
    if not customer_order:
        print("\nYour cart is empty. Nothing to save.")
        return
    try:
#Updated Code 1: Provides token number and puts a limit for number of online orders per day
        mydb.execute("SELECT max(order_id) FROM orders WHERE DATE(order_time) = CURDATE()")
        row=mydb.fetchone()
        daily_count=row[0]+1 if (row is not None and row[0] is not None) else 1
        if daily_count>100:
            print("Order Rejected! The system has reached its daily limit of 100 orders.")
            print("Please try again tomorrow!")
            customer_order.clear()
            return False
        else:
            for item in customer_order:
                order_no=daily_count
                mydb.execute("""INSERT INTO orders (order_id,username,item_name,veg_nonveg,price,restaurant_name)
                VALUES (%s, %s, %s, %s, %s, %s)""", (order_no, username, item[1], item[2], item[4],restaurant_name))
            db.commit()
            print("\n Order saved successfully to database!")
            print("Order Number:",order_no)
    except mysql.connector.Error as err:
        print(f"Database error while saving order: {err}")
        
def past_orders(username):
    try:
        mydb.execute("SELECT order_id, item_name, veg_nonveg, price, restaurant_name, order_time FROM orders WHERE username = %s ORDER BY order_time DESC", (username,))
        orders = mydb.fetchall()
        if not orders:
            print("\nNo past orders found for this user.")
            return

        header = ["OrderNo","Item", "Veg/NonVeg", "Price", "Restaurant", "Order Time"]
        print(f"\n--- Past Orders for {username} ---")
        print(tabulate(orders, headers=header, tablefmt='grid', numalign="right", stralign="left"))
    except mysql.connector.Error as err:
        print(f"Database error while fetching orders: {err}")


